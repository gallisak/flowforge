NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flowforge_app:flowforge_app@postgres:5432/flowforge
MIGRATION_DATABASE_URL=postgres://flowforge_owner:flowforge_owner@postgres:5432/flowforge
ADMIN_TOKEN=change-me-admin
WORKER_CONCURRENCY=4
SCHEDULER_TICK_MS=30000
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_SECRET_GRACE_SECONDS=86400
WORKER_LEASE_SECONDS=30
WORKER_REAPER_INTERVAL_MS=5000
WORKER_SHUTDOWN_GRACE_MS=25000
RETRY_BASE_MS=1000
RETRY_CAP_MS=300000
TRANSFORM_TIMEOUT_MS=100
TRANSFORM_MEMORY_MB=32
HTTP_TIMEOUT_MS=15000
HTTP_MAX_REDIRECTS=5
HTTP_MAX_RESPONSE_BYTES=1048576
STEP_OUTPUT_MAX_BYTES=1048576
SSRF_ALLOWLIST=
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
